# Copy to qa/.env.regression.local (ignored by Git), then edit locally.
# Never paste a real key in this example or in a command-line argument.
REGRESSION_OPENAI_API_KEY=
REGRESSION_OPENAI_MODEL=gpt-4o-mini
REGRESSION_OPENAI_VISION_MODEL=gpt-4.1-mini
REGRESSION_MAX_AI_CALLS=20
REGRESSION_MAX_OUTPUT_TOKENS=4096
REGRESSION_AI_TIMEOUT_SECONDS=45
# Stop initiating new calls once actual cumulative usage reaches this threshold.
# A final in-flight response can exceed this token threshold. This is not a dollar cap.
REGRESSION_MAX_TOTAL_TOKENS=100000
