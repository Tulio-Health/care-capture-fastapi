# FastAPI Local Development Configuration
# This file configures the app to use AWS SSM Parameter Store for configuration

AWS_REGION=us-east-2
USE_SSM_LOCALLY=true
# API Configuration
PORT=8000
DEBUG=true

# Logging Configuration
LOG_LEVEL=DEBUG
ENABLE_CONSOLE_LOG=true
ENABLE_FILE_LOG=false
# LOG_FILE=logs/app.log
# ENABLE_JSON_LOGS=true
# LOG_FORMAT=json

# LangSmith Configuration (not in SSM yet - configure locally if needed)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=

AWS_PROFILE=tuliodev

# The following will be loaded from SSM Parameter Store:
# - Database configuration (host, port, username, password, name, ssl)
# - Redis configuration (host, port, password) - overridden to localhost for local dev  
# - OpenAI API key
# - Other service configurations

# Note: Redis will be automatically overridden to use localhost:6379 for local development
# while still loading AWS ElastiCache settings from SSM for deployed environments